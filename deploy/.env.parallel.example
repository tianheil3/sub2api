# =============================================================================
# Sub2API Parallel Docker Environment
# =============================================================================
# Usage:
#   cp .env.parallel.example .env.parallel
#   mkdir -p data_parallel postgres_data_parallel redis_data_parallel
#   docker compose --env-file .env.parallel -f docker-compose.parallel.local.yml up -d
# =============================================================================

# Host bind address for all exposed ports
PARALLEL_BIND_HOST=127.0.0.1

# Host ports chosen to avoid the default stack (8080 / 5432 / 6379)
PARALLEL_SERVER_PORT=18080
PARALLEL_POSTGRES_HOST_PORT=15432
PARALLEL_REDIS_HOST_PORT=16379

# Runtime mode
PARALLEL_SERVER_MODE=release
PARALLEL_RUN_MODE=standard
PARALLEL_TZ=Asia/Shanghai

# Fresh PostgreSQL instance for the parallel stack
PARALLEL_POSTGRES_USER=sub2api_parallel
PARALLEL_POSTGRES_PASSWORD=change_this_parallel_postgres_password
PARALLEL_POSTGRES_DB=sub2api_parallel

# Fresh Redis instance for the parallel stack
PARALLEL_REDIS_PASSWORD=
PARALLEL_REDIS_DB=0

# Admin bootstrap account for the parallel stack
PARALLEL_ADMIN_EMAIL=admin-parallel@sub2api.local
PARALLEL_ADMIN_PASSWORD=

# Fixed secrets are recommended so sessions survive restarts
PARALLEL_JWT_SECRET=
PARALLEL_TOTP_ENCRYPTION_KEY=
PARALLEL_JWT_EXPIRE_HOUR=24

# Optional throughput tuning
PARALLEL_DATABASE_MAX_OPEN_CONNS=50
PARALLEL_DATABASE_MAX_IDLE_CONNS=10
PARALLEL_DATABASE_CONN_MAX_LIFETIME_MINUTES=30
PARALLEL_DATABASE_CONN_MAX_IDLE_TIME_MINUTES=5
PARALLEL_REDIS_POOL_SIZE=1024
PARALLEL_REDIS_MIN_IDLE_CONNS=10
PARALLEL_REDIS_ENABLE_TLS=false

# Optional upstream/auth settings
PARALLEL_GEMINI_OAUTH_CLIENT_ID=
PARALLEL_GEMINI_OAUTH_CLIENT_SECRET=
PARALLEL_GEMINI_OAUTH_SCOPES=
PARALLEL_GEMINI_QUOTA_POLICY=
PARALLEL_GEMINI_CLI_OAUTH_CLIENT_SECRET=
PARALLEL_ANTIGRAVITY_OAUTH_CLIENT_SECRET=
PARALLEL_SECURITY_URL_ALLOWLIST_ENABLED=false
PARALLEL_SECURITY_URL_ALLOWLIST_ALLOW_INSECURE_HTTP=false
PARALLEL_SECURITY_URL_ALLOWLIST_ALLOW_PRIVATE_HOSTS=false
PARALLEL_SECURITY_URL_ALLOWLIST_UPSTREAM_HOSTS=
PARALLEL_UPDATE_PROXY_URL=
